# .env.lab.example  (plantilla para el PC del laboratorio)
# Copia este archivo a .env.lab y rellena los datos publicos que te da Railway:
#   cp .env.lab.example .env.lab
# Uso:
#   docker compose -f docker-compose.lab.yml --env-file .env.lab up -d ws01_monitor ws01_engine
# .env.lab NO se sube a GitHub (esta en .gitignore).

# Dominio publico (TCP Proxy) del servicio wm_central en Railway, SIN puerto.
CENTRAL_HOST=tu-central.proxy.rlwy.net
# Puerto publico que Railway asigna a ese TCP Proxy (apunta al puerto 5000 de wm_central).
CENTRAL_PORT=12345
# Broker de Kafka en Railway (TCP Proxy del servicio kafka), formato dominio:puerto.
KAFKA_BROKER=tu-kafka.proxy.rlwy.net:54321
