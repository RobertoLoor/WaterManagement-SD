# .env  (raiz del proyecto)
# Lo lee docker compose de forma automatica para sustituir las ${VARIABLES} del
# docker-compose.yml. Esta en .gitignore, por eso NO se sube a GitHub.
PYTHONPATH=.

# Valores por defecto para pruebas en local con docker-compose.yml.
# En Railway, sustituir por el dominio/puerto publico real del TCP Proxy de Kafka.

# Host con el que Kafka se anuncia a los clientes externos (WM_WS / WM_FO).
KAFKA_EXTERNAL_HOST=127.0.0.1
# Puerto publico del listener EXTERNAL de Kafka.
KAFKA_EXTERNAL_PORT=9093
# Puerto de sockets de WM_Central (registro de los Monitores).
SOCKET_PORT=5000
# Puerto del dashboard web de WM_Central.
WEB_PORT=8080